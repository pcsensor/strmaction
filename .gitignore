# ---------------------------------------------------------------------------
# StrmAction
#
# 原则：不提交依赖、构建产物、运行时数据、密钥与本地环境配置。
# 例外：companion/strmaction-companion-v1.apk 是已签名交付物，保留在仓库；
#       它的构建目录与签名 keystore 仍然不提交。
# ---------------------------------------------------------------------------

# --- Python ----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# --- Node / 前端 -----------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/vite.config.js
frontend/vite.config.d.ts
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 运行时数据 / 本地配置 -------------------------------------------------
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/config.yaml
.session_secret
*.log
logs/

# 环境变量（含密钥）；示例文件保留
.env
.env.*
!.env.example
!.env.cloud.example

# --- 演示 / 测试产物 -------------------------------------------------------
/sample-media/
scripts/.demo-cache/
tmp_*
*.tmp
*.bak

# --- Android / Gradle ------------------------------------------------------
.gradle/
.kotlin/
companion/captures/
.cxx/
.externalNativeBuild/
local.properties
*.jks
*.keystore
*.apk.idsig

# 其余 app/build 下的 APK/AAB 均由上面的 build/ 规则忽略
companion/**/build/

# --- IDE / 操作系统 --------------------------------------------------------
.idea/
.vscode/
.fleet/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- 其他 -----------------------------------------------------------------
*.tgz
*.zip
