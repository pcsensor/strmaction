# 统一换行，避免 Windows 开发 + Linux 部署时的 CRLF 问题
* text=auto eol=lf

# 二进制文件：不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.webm binary
*.mp4 binary
*.apk binary
*.jks binary
*.keystore binary
*.woff binary
*.woff2 binary

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
