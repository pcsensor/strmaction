# 复制为 .env 后按需修改：
#   cp .env.cloud.example .env
# 然后：
#   docker compose -f docker-compose.cloud.yml up -d --build

# 对外访问地址（浏览器 / 伴侣 App 里填的地址要完全一致；https 时 Cookie 自动加 Secure）
STRMACTION_BASE_URL=https://media.example.com

# 宿主机上的 .strm 根目录（只读挂载到容器 /media/strm）
# 大陆/海外服务器都可以只同步 .strm 文本，不需要同步视频文件
STRMACTION_MEDIA_PATH=/srv/strm

# 元数据源（至少填一个；也可以先留空，之后在设置页填）
STRMACTION_TMDB_KEY=
STRMACTION_TVDB_KEY=
STRMACTION_TVDB_PIN=

# 仅配合 Caddy 容器自动化证书方案需要（对应 Caddyfile 配置）
# STRMACTION_DOMAIN=media.example.com

# 服务器访问 TMDB/TVDB 需要代理时填写，例如 http://127.0.0.1:7890
# 单独给某个 provider 配代理，可在设置页或 config.yaml 里覆盖
STRMACTION_PROXY=

# 国内构建加速（可选）：npm / pip 镜像源
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
